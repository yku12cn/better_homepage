{
  "manifest_version": 3,
  "name": "Better Homepage",
  "version": "1.6",
  "description": "A customizable replacement for Chrome's new tab page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Better Homepage",
    "default_icon": "icons/icon48.png"
  }
}